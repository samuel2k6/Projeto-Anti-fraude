# =============================================================================
# .env.example — Template de configuração do Projeto Anti-Fraude Sicredi
# =============================================================================
# Este arquivo é um TEMPLATE seguro para versionamento no git.
# Para usar:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores reais no .env (nunca versione o .env)
#
# Como obter as API Keys:
#   IBM Cloud API Key  → https://cloud.ibm.com/iam/apikeys
#   watsonx Projetos   → https://dataplatform.cloud.ibm.com/wx/home
# =============================================================================

# -----------------------------------------------------------------------------
# IBM Cloud
# -----------------------------------------------------------------------------

# API Key principal da sua conta IBM Cloud
# Criada em: https://cloud.ibm.com/iam/apikeys → "Criar chave de API"
IBMCLOUD_API_KEY=

# Região IBM Cloud onde os serviços estão provisionados
# Exemplos: us-south | eu-de | br-sao
IBMCLOUD_REGION=us-south

# Resource Group (deixe "default" se não criou outro)
IBMCLOUD_RESOURCE_GROUP=default

# -----------------------------------------------------------------------------
# watsonx Orchestrate
# -----------------------------------------------------------------------------

# API Key do watsonx (pode ser a mesma IBMCLOUD_API_KEY ou uma chave dedicada)
# Criada em: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=

# URL base da instância watsonx de acordo com a região:
#   us-south → https://us-south.ml.cloud.ibm.com
#   eu-de    → https://eu-de.ml.cloud.ibm.com
#   br-sao   → https://br-sao.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Project ID do watsonx (em: watsonx.ai → Configurações do Projeto → ID)
WATSONX_PROJECT_ID=

# ID da instância watsonx Orchestrate (em: IBM Cloud → Lista de recursos)
WATSONX_ORCHESTRATE_INSTANCE_ID=

# -----------------------------------------------------------------------------
# Configurações do Agente (opcionais — usam padrões se não definidos)
# -----------------------------------------------------------------------------

# Modelo LLM usado pelo agente de orquestração
# Opções: ibm/granite-13b-chat-v2 | meta-llama/llama-3-70b-instruct
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# Ambiente de execução: development | staging | production
APP_ENV=development

# Habilitar log detalhado das chamadas IBM Cloud (true/false)
IBMCLOUD_DEBUG=false
